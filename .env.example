HOST=127.0.0.1
PORT=8787
OPENAI_API_KEY=
STT_MODEL=gpt-live-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
# openai, deepseek, codex, claude, or demo (demo never calls an AI provider)
ANALYZER=codex
# Optional model override. Blank uses the CLI's configured default.
ANALYZER_MODEL=gpt-6-astra
# Optional executable path; for Codex a path to bin/codex.js is also supported.
CODEX_BIN=
CLAUDE_BIN=
# OCR is local; first use downloads eng and chi_sim language weights.
OCR_ENABLED=true
# Set certificate paths after mkcert (see README); enable HOST=0.0.0.0 for LAN.
TLS_KEY=
TLS_CERT=
# Optional fixed pairing token. If empty a random token is generated at startup.
PAIR_TOKEN=

# Codex reasoning effort for image analysis and answers
ANALYZER_EFFORT=low

# For ANALYZER=deepseek set ANALYZER_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# For direct OpenAI image answers: ANALYZER=openai, ANALYZER_MODEL=gpt-6-luna.
# OPENAI_API_KEY can be inherited from the server process environment.
# If Node.js 22.21+ / 24.5+ needs your HTTP proxy, set HTTPS_PROXY and
# NODE_OPTIONS=--use-env-proxy locally (including when using npm start).

# Mouse version (npm run start:mouse). It shares ANALYZER*, HOST, TLS_* and PAIR_TOKEN above.
# With PAIR_TOKEN empty it creates a 10-character code once and keeps it in data/mouse/pair-token.txt.
MOUSE_PORT=8790
# Captures answered at the same time
MOUSE_CONCURRENCY=2
# Different screens kept from one long press; the burst ends when this is reached
MOUSE_MAX_FRAMES=12
